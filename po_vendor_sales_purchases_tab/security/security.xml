<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="vendor_sheet_invoice_company_rule" model="ir.rule">
            <field name="name">Vendor Sheet Invoice multi-company</field>
            <field name="model_id" ref="model_vendor_sheet_invoice"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="vendor_sucursal_mapping_company_rule" model="ir.rule">
            <field name="name">Vendor Sucursal Mapping multi-company</field>
            <field name="model_id" ref="model_vendor_sucursal_mapping"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

        <record id="vendor_sales_snapshot_company_rule" model="ir.rule">
            <field name="name">Vendor Sales Snapshot multi-company</field>
            <field name="model_id" ref="model_vendor_sales_snapshot"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>
    </data>
</odoo>
