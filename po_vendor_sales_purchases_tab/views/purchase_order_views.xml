<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_sheet_invoice_tree_po_tab" model="ir.ui.view">
        <field name="name">vendor.sheet.invoice.tree.po.tab</field>
        <field name="model">vendor.sheet.invoice</field>
        <field name="arch" type="xml">
            <tree string="Facturas de hoja de proveedor" create="0" edit="0" delete="0" expand="0">
                <field name="no_factura"/>
                <field name="fecha"/>
                <field name="vence"/>
                <field name="total_factura" sum="Total"/>
                <field name="pagado" widget="boolean_toggle"/>
                <field name="fecha_pago"/>
                <field name="sucursal" optional="hide"/>
                <field name="monto_pago_grupo" optional="hide"/>
                <field name="facturas_en_grupo" optional="hide"/>
                <field name="proveedor" optional="hide"/>
                <field name="warning_message" optional="hide"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_purchase_order_form_vendor_sales_purchases_tab" model="ir.ui.view">
        <field name="name">purchase.order.form.vendor.sales.purchases.tab</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="custom_purchase_flow.view_purchase_order_form_custom"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Compras vs Ventas"
                      name="vendor_sales_purchases_tab"
                      groups="purchase.group_purchase_user,custom_purchase_flow.group_purchase_direction,custom_purchase_flow.group_purchase_dept,base.group_system">
                    <field name="vendor_sales_matrix" invisible="1"/>
                    <div class="alert alert-warning mb-2"
                         attrs="{'invisible': [('vendor_tab_warning', '=', False)]}">
                        <field name="vendor_tab_warning" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-warning mb-2"
                         attrs="{'invisible': [('vendor_sales_matrix_warning', '=', False)]}">
                        <field name="vendor_sales_matrix_warning" nolabel="1" readonly="1"/>
                    </div>
                    <div class="alert alert-warning mb-2"
                         attrs="{'invisible': [('vendor_tab_po_stale_warning', '=', False)]}">
                        <field name="vendor_tab_po_stale_warning" nolabel="1" readonly="1"/>
                    </div>
                    <div class="row mb-3 align-items-center">
                        <div class="col-md-8">
                            <strong>
                                <field name="vendor_tab_partner_name" nolabel="1" class="oe_inline"/>
                                — Compras (facturas, mes actual + 3 meses anteriores) | Ventas por departamento (mes actual + 3 meses anteriores)
                            </strong>
                        </div>
                        <div class="col-md-4 text-right">
                            <div class="mb-1">
                                <span class="mr-2">
                                    Última sincronización global:
                                    <field name="vendor_tab_last_sync" readonly="1" nolabel="1" class="oe_inline"/>
                                </span>
                            </div>
                            <div class="mb-1">
                                <span class="mr-2">
                                    Última sincronización de OC:
                                    <field name="vendor_tab_po_last_sync" readonly="1" nolabel="1" class="oe_inline"/>
                                </span>
                            </div>
                            <button name="action_sync_global_vendor_sheets"
                                    type="object"
                                    string="Sincronizar global"
                                    class="btn-secondary mr-1"
                                    title="Actualiza las facturas de compra desde Google Sheets para todas las sucursales."
                                    groups="custom_purchase_flow.group_purchase_direction,custom_purchase_flow.group_purchase_dept,base.group_system"/>
                            <button name="action_sync_po_vendor_tab"
                                    type="object"
                                    string="Sincronizar OC"
                                    class="btn-primary"
                                    title="Actualiza ventas y compras de este proveedor y sucursal."
                                    groups="custom_purchase_flow.group_purchase_direction,custom_purchase_flow.group_purchase_dept,base.group_system"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <h5>Ventas por departamento</h5>
                            <field name="vendor_sales_matrix_html" nolabel="1" readonly="1"/>
                        </div>
                        <div class="col-md-6">
                            <h5>Compras (Google Sheets)</h5>
                            <field name="vendor_sheet_invoice_ids" invisible="1"/>
                            <field name="vendor_sheet_purchases_html" nolabel="1" readonly="1"/>
                        </div>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
