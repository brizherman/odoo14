<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_sheet_month_tree" model="ir.ui.view">
        <field name="name">vendor.sheet.month.tree</field>
        <field name="model">vendor.sheet.month</field>
        <field name="arch" type="xml">
            <tree string="Monthly Workbooks" editable="bottom">
                <field name="year"/>
                <field name="month"/>
                <field name="name" readonly="1" optional="hide"/>
                <field name="spreadsheet_id"/>
                <field name="synced_once" readonly="1"/>
                <field name="last_sync" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="view_vendor_sheet_config_form" model="ir.ui.view">
        <field name="name">vendor.sheet.config.form</field>
        <field name="model">vendor.sheet.config</field>
        <field name="arch" type="xml">
            <form string="Vendor Sheet Configuration">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="sheet_tab_name"
                               groups="base.group_system"/>
                        <field name="google_service_account_json"
                               widget="text"
                               groups="base.group_system"/>
                    </group>
                    <notebook>
                        <page string="Monthly Workbooks">
                            <field name="sheet_month_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="year"/>
                                    <field name="month"/>
                                    <field name="name" readonly="1" optional="hide"/>
                                    <field name="spreadsheet_id"/>
                                    <field name="synced_once" readonly="1"/>
                                    <field name="last_sync" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vendor_sheet_config" model="ir.actions.act_window">
        <field name="name">Vendor Sheet Settings</field>
        <field name="res_model">vendor.sheet.config</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'form_view_initial_mode': 'edit'}</field>
    </record>

    <record id="action_vendor_sheet_config_singleton" model="ir.actions.server">
        <field name="name">Vendor Sheet Settings</field>
        <field name="model_id" ref="model_vendor_sheet_config"/>
        <field name="state">code</field>
        <field name="code">
config = env['vendor.sheet.config'].get_singleton()
action = {
    'type': 'ir.actions.act_window',
    'name': 'Vendor Sheet Settings',
    'res_model': 'vendor.sheet.config',
    'view_mode': 'form',
    'res_id': config.id,
    'target': 'current',
}
        </field>
    </record>
</odoo>
