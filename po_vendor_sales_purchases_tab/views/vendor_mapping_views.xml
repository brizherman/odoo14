<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendor_sucursal_mapping_tree" model="ir.ui.view">
        <field name="name">vendor.sucursal.mapping.tree</field>
        <field name="model">vendor.sucursal.mapping</field>
        <field name="arch" type="xml">
            <tree string="Mapeos de sucursal" editable="bottom">
                <field name="sucursal"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="view_vendor_sucursal_mapping_form" model="ir.ui.view">
        <field name="name">vendor.sucursal.mapping.form</field>
        <field name="model">vendor.sucursal.mapping</field>
        <field name="arch" type="xml">
            <form string="Mapeo de sucursal">
                <sheet>
                    <group>
                        <field name="sucursal"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_vendor_sheet_mapping_tree" model="ir.ui.view">
        <field name="name">vendor.sheet.mapping.tree</field>
        <field name="model">vendor.sheet.mapping</field>
        <field name="arch" type="xml">
            <tree string="Mapeos de proveedor" editable="bottom"
                  decoration-warning="not partner_id">
                <field name="sheet_proveedor"/>
                <field name="partner_id"/>
                <field name="classification_vendor_id"/>
                <field name="is_assigned" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_vendor_sheet_mapping_search" model="ir.ui.view">
        <field name="name">vendor.sheet.mapping.search</field>
        <field name="model">vendor.sheet.mapping</field>
        <field name="arch" type="xml">
            <search string="Mapeos de proveedor">
                <field name="sheet_proveedor"/>
                <field name="partner_id"/>
                <filter name="filter_pending_assignment"
                        string="Pendientes de asignar"
                        domain="[('partner_id', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_vendor_sheet_mapping_form" model="ir.ui.view">
        <field name="name">vendor.sheet.mapping.form</field>
        <field name="model">vendor.sheet.mapping</field>
        <field name="arch" type="xml">
            <form string="Mapeo de proveedor">
                <sheet>
                    <group>
                        <field name="sheet_proveedor"/>
                        <field name="partner_id"/>
                        <field name="classification_vendor_id"/>
                        <field name="is_assigned" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vendor_sucursal_mapping" model="ir.actions.act_window">
        <field name="name">Mapeos de sucursal</field>
        <field name="res_model">vendor.sucursal.mapping</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_vendor_sheet_mapping" model="ir.actions.act_window">
        <field name="name">Mapeos de proveedor</field>
        <field name="res_model">vendor.sheet.mapping</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
