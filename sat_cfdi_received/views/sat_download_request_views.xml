<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sat_download_request_tree" model="ir.ui.view">
        <field name="name">sat.download.request.tree</field>
        <field name="model">sat.download.request</field>
        <field name="arch" type="xml">
            <tree string="Solicitudes de descarga SAT" create="0">
                <field name="name" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="date_from" optional="hide"/>
                <field name="date_to" optional="hide"/>
                <field name="state" optional="hide"/>
                <field name="sat_request_id" optional="show"/>
                <field name="records_count" optional="hide"/>
                <field name="create_date" string="Fecha de creación" optional="hide"/>
                <field name="last_check_date" optional="show"/>
                <field name="has_packages" optional="show"/>
                <field name="package_ids" optional="show"/>
                <field name="error_message" optional="show"/>
                <field name="create_uid" string="Creado por" optional="show"/>
                <field name="write_date" string="Última modificación" optional="show"/>
                <field name="write_uid" string="Modificado por" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_sat_download_request_form" model="ir.ui.view">
        <field name="name">sat.download.request.form</field>
        <field name="model">sat.download.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de descarga SAT" create="0">
                <header>
                    <button name="action_submit" type="object" string="Enviar al SAT"
                            class="btn-secondary"
                            groups="sat_cfdi_received.group_sat_manager"
                            attrs="{'invisible': ['|', ('state', 'not in', ['draft', 'error']), '&amp;', ('state', '=', 'error'), ('sat_request_id', '!=', False)]}"/>
                    <button name="action_check_and_download" type="object" string="Sincronizar desde el SAT"
                            class="btn-primary"
                            groups="sat_cfdi_received.group_sat_manager"
                            attrs="{'invisible': ['|', ('sat_request_id', '=', False), ('state', 'in', ['done', 'no_data', 'draft'])]}"/>
                    <button name="action_process_packages" type="object" string="Procesar paquetes"
                            groups="sat_cfdi_received.group_sat_manager"
                            attrs="{'invisible': [('has_packages', '=', False)]}"/>
                    <button name="action_reset_request" type="object" string="Reiniciar"
                            class="btn-secondary"
                            groups="sat_cfdi_received.group_sat_manager"
                            attrs="{'invisible': [('sat_request_id', '=', False)]}"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,requested,processing,done,no_data,error"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="date_from" readonly="1"/>
                            <field name="date_to" readonly="1"/>
                        </group>
                        <group>
                            <field name="sat_request_id" readonly="1"/>
                            <field name="records_count" readonly="1"/>
                            <field name="create_date" string="Fecha de creación" readonly="1"/>
                            <field name="last_check_date" readonly="1"/>
                            <field name="has_packages" invisible="1"/>
                            <field name="package_ids" readonly="1" widget="text"
                                   attrs="{'invisible': [('has_packages', '=', False)]}"/>
                        </group>
                    </group>
                    <group attrs="{'invisible': [('error_message', '=', False)]}">
                        <field name="error_message" readonly="1" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="CFDIs recibidos">
                            <field name="cfdi_ids" readonly="1">
                                <tree>
                                    <field name="invoice_date"/>
                                    <field name="supplier_name"/>
                                    <field name="total"/>
                                    <field name="uuid"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sat_download_request" model="ir.actions.act_window">
        <field name="name">Solicitudes de descarga</field>
        <field name="res_model">sat.download.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
