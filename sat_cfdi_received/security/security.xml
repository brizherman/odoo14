<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_sat_user" model="res.groups">
            <field name="name">SAT / Usuario</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_sat_manager" model="res.groups">
            <field name="name">SAT / Administrador</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_sat_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="sat_cfdi_received_company_rule" model="ir.rule">
            <field name="name">CFDI recibido SAT multiempresa</field>
            <field name="model_id" ref="model_sat_cfdi_received"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="sat_download_request_company_rule" model="ir.rule">
            <field name="name">Solicitud de descarga SAT multiempresa</field>
            <field name="model_id" ref="model_sat_download_request"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
