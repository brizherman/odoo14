<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sat_download_wizard_form" model="ir.ui.view">
        <field name="name">sat.download.wizard.form</field>
        <field name="model">sat.download.wizard</field>
        <field name="arch" type="xml">
            <form string="Descargar CFDIs recibidos">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_request_download" type="object" string="Solicitar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sat_download_wizard" model="ir.actions.act_window">
        <field name="name">Descargar CFDIs recibidos</field>
        <field name="res_model">sat.download.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('sat_cfdi_received.group_sat_manager'))]"/>
    </record>
</odoo>
