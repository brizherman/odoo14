<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layaway_report_amount">
        <span style="white-space: nowrap;">
            <span t-esc="amount" t-options="{'widget': 'float', 'precision': campaign['precision']}"/>
            <span t-esc="campaign['currency']"/>
        </span>
    </template>

    <template id="layaway_report_cash_row">
        <tr t-att-class="'font-weight-bold' if row['subtotal'] else ''" style="page-break-inside: avoid;">
            <td>
                <div t-if="row['session']" t-esc="row['session']"/>
                <span t-esc="row['label']"/>
                <t t-if="row['method']"> · <span t-esc="row['method']"/></t>
            </td>
            <td t-foreach="('collected', 'reversal', 'replacement', 'net')" t-as="column" class="text-right">
                <t t-call="pos_layaway.layaway_report_amount">
                    <t t-set="amount" t-value="row[column]"/>
                </t>
            </td>
        </tr>
    </template>

    <template id="layaway_report_closing">
        <section class="layaway-closing mt-3">
            <h5>Situación al cierre del rango</h5>
            <p>Historial acumulado de los folios con movimientos en el periodo. El neto de caja figura en el resumen por sesión receptora.</p>
            <t t-set="closing" t-value="campaign['closing']"/>
            <t t-foreach="closing['folios']" t-as="snapshot">
                <h6>
                    <strong t-esc="snapshot['folio']"/> · <span t-esc="snapshot['customer']"/>
                    <span class="small">
                        · Recogida hasta <span t-esc="snapshot['pickup_end']" t-options="{'widget': 'date'}"/>
                    </span>
                </h6>
                <table t-if="snapshot['rows']" class="table table-sm small">
                    <thead>
                        <tr>
                            <th>Tienda y producto</th>
                            <th class="text-right">Reserva inicial</th>
                            <th class="text-right">Adiciones</th>
                            <th class="text-right">Traslados entrada / salida</th>
                            <th class="text-right">Liberadas</th>
                            <th class="text-right">Entregadas</th>
                            <th class="text-right">Pendientes</th>
                            <th class="text-right">Valor reservado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="snapshot['rows']" t-as="row" style="page-break-inside: avoid;">
                            <td>
                                <strong t-esc="row['store']"/>
                                <div t-if="row['context']">Contexto de otra tienda</div>
                                <div t-esc="row['name']"/>
                            </td>
                            <td t-foreach="('initial', 'added')" t-as="column" class="text-right"
                                t-esc="row[column]"
                                t-options="{'widget': 'float', 'precision': closing['quantity_precision']}"/>
                            <td class="text-right">
                                <span t-esc="row['transferred_in']"
                                      t-options="{'widget': 'float', 'precision': closing['quantity_precision']}"/>
                                /
                                <span t-esc="row['transferred_out']"
                                      t-options="{'widget': 'float', 'precision': closing['quantity_precision']}"/>
                            </td>
                            <td t-foreach="('released', 'delivered', 'pending')" t-as="column" class="text-right"
                                t-esc="row[column]"
                                t-options="{'widget': 'float', 'precision': closing['quantity_precision']}"/>
                            <td class="text-right">
                                <t t-call="pos_layaway.layaway_report_amount">
                                    <t t-set="amount" t-value="row['reserved_value']"/>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <p class="small">
                    <strong>Valor reservado visible</strong>
                    <t t-call="pos_layaway.layaway_report_amount">
                        <t t-set="amount" t-value="snapshot['reserved']"/>
                    </t>
                    · <strong>Cobrado en cajas accesibles</strong>
                    <t t-call="pos_layaway.layaway_report_amount">
                        <t t-set="amount" t-value="snapshot['paid']"/>
                    </t>
                    <t t-if="snapshot['due'] is not None">
                        · <strong>Restante del folio</strong>
                        <t t-call="pos_layaway.layaway_report_amount">
                            <t t-set="amount" t-value="snapshot['due']"/>
                        </t>
                    </t>
                    <t t-if="snapshot['credit']">
                        · <strong>Saldo por vencimiento</strong>
                        <t t-call="pos_layaway.layaway_report_amount">
                            <t t-set="amount" t-value="snapshot['credit']['amount']"/>
                        </t>
                        (<span t-esc="snapshot['credit']['label']"/>)
                    </t>
                </p>
            </t>
            <p class="font-weight-bold small">
                Total de la campaña al cierre · Valor reservado visible
                <t t-call="pos_layaway.layaway_report_amount">
                    <t t-set="amount" t-value="closing['reserved']"/>
                </t>
                · Cobrado en cajas accesibles
                <t t-call="pos_layaway.layaway_report_amount">
                    <t t-set="amount" t-value="closing['paid']"/>
                </t>
            </p>
        </section>
    </template>

    <template id="report_saledetails_layaway" inherit_id="point_of_sale.report_saledetails">
        <xpath expr="//div[hasclass('page')]" position="inside">
            <section t-if="layaway_campaigns" id="layaway_sales_details" class="mt-4">
                <h3>Apartados</h3>
                <t t-foreach="layaway_campaigns" t-as="campaign">
                    <h4 t-esc="campaign['name']"/>
                    <h5>Movimientos del periodo</h5>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Fecha y hora · Tienda · Caja · Sesión</th>
                                <th>Operación · Folio · Cliente · Cajero</th>
                                <th class="text-right">Método e importe</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="campaign['movements']" t-as="movement" style="page-break-inside: avoid;">
                                <td>
                                    <span t-esc="movement['date']" t-options="{'widget': 'datetime'}"/>
                                    <br/>
                                    <span t-esc="movement['store']"/>
                                    <br/>
                                    <span t-esc="movement['config']"/> · <span t-esc="movement['session']"/>
                                </td>
                                <td>
                                    <strong t-esc="movement['label']"/>
                                    <br/>
                                    <span t-esc="movement['folio']"/> · <span t-esc="movement['customer']"/>
                                    <br/>
                                    Cajero <span t-esc="movement['cashier']"/>
                                    <div t-if="movement['authorizer']">
                                        Autorizó <span t-esc="movement['authorizer']"/>
                                    </div>
                                    <div class="small">Ref. <span t-esc="movement['reference']"/></div>
                                    <div t-if="movement['original_reference']" class="small">
                                        Ref. de origen <span t-esc="movement['original_reference']"/>
                                    </div>
                                    <div t-if="movement['sale_name']">Venta <span t-esc="movement['sale_name']"/></div>
                                </td>
                                <td class="text-right">
                                    <div t-foreach="movement['breakdown']" t-as="line">
                                        <span t-esc="line['method']"/>
                                        <span t-if="line['effect'] == 'reversal'">(reversión)</span>
                                        <span t-if="line['effect'] == 'replacement'">(reclasificación)</span>
                                        <t t-call="pos_layaway.layaway_report_amount">
                                            <t t-set="amount" t-value="line['amount']"/>
                                        </t>
                                    </div>
                                    <div t-if="movement['breakdown']">
                                        <strong>Neto de la operación</strong>
                                        <t t-call="pos_layaway.layaway_report_amount">
                                            <t t-set="amount" t-value="movement['amount']"/>
                                        </t>
                                    </div>
                                    <div t-if="not movement['breakdown']">Sin dinero nuevo</div>
                                    <div t-if="movement['previous']">
                                        Pagos previos aplicados
                                        <t t-call="pos_layaway.layaway_report_amount">
                                            <t t-set="amount" t-value="movement['previous']"/>
                                        </t>
                                    </div>
                                    <div t-if="movement['credit_applied']">
                                        Saldo aplicado
                                        <t t-call="pos_layaway.layaway_report_amount">
                                            <t t-set="amount" t-value="movement['credit_applied']"/>
                                        </t>
                                    </div>
                                    <div t-if="movement['credit_issued']">
                                        Saldo emitido
                                        <t t-call="pos_layaway.layaway_report_amount">
                                            <t t-set="amount" t-value="movement['credit_issued']"/>
                                        </t>
                                    </div>
                                    <div t-if="movement['linked_sale'] is not None">
                                        Valor de venta vinculada
                                        <t t-call="pos_layaway.layaway_report_amount">
                                            <t t-set="amount" t-value="movement['linked_sale']"/>
                                        </t>
                                    </div>
                                    <div t-if="movement['adjustment']">
                                        Ajuste <span t-esc="movement['adjustment']['name']"/>
                                        <t t-call="pos_layaway.layaway_report_amount">
                                            <t t-set="amount" t-value="movement['adjustment']['amount']"/>
                                        </t>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <h5>Resumen de caja por sesión receptora</h5>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Tienda · Caja · Sesión / Tipo · Método</th>
                                <th class="text-right">Cobros nuevos</th>
                                <th class="text-right">Reversiones</th>
                                <th class="text-right">Reposiciones por reclasificación</th>
                                <th class="text-right">Neto</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="campaign['cash_by_session']" t-as="row">
                                <t t-call="pos_layaway.layaway_report_cash_row"/>
                            </t>
                            <t t-call="pos_layaway.layaway_report_cash_row">
                                <t t-set="row" t-value="campaign['cash_total']"/>
                            </t>
                        </tbody>
                    </table>

                    <h5>Importes fuera del neto de caja</h5>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Pagos previos aplicados</th>
                                <th>Saldo emitido</th>
                                <th>Saldo aplicado</th>
                                <th>Valor de ventas vinculadas</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td t-foreach="('previous', 'credit_issued', 'credit_applied', 'linked_sale')" t-as="column">
                                    <t t-call="pos_layaway.layaway_report_amount">
                                        <t t-set="amount" t-value="campaign['other_totals'][column]"/>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <t t-call="pos_layaway.layaway_report_closing"/>
                </t>
            </section>
        </xpath>
    </template>
</odoo>
