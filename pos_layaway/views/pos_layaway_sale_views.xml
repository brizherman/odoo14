<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_layaway_form" model="ir.ui.view">
        <field name="name">pos.layaway.form</field>
        <field name="model">pos.layaway</field>
        <field name="arch" type="xml">
            <form string="Apartado" create="false" edit="false" delete="false">
                <sheet>
                    <h1><field name="folio"/></h1>
                    <group>
                        <group>
                            <field name="campaign_name"/>
                            <field name="contact_name"/>
                            <field name="sale_id"/>
                            <field name="payment_state"/>
                            <field name="pickup_state"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_total"/>
                            <field name="amount_paid"/>
                            <field name="amount_due"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <tree>
                            <field name="product_name"/>
                            <field name="warehouse_id"/>
                            <field name="qty"/>
                            <field name="qty_pending"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="pos_order_form_layaway" model="ir.ui.view">
        <field name="name">pos.order.form.layaway</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_fields']/field[@name='session_id']" position="after">
                <field name="layaway_ids" groups="pos_layaway.group_layaway_campaign_manager"
                       attrs="{'invisible': [('layaway_ids', '=', [])]}">
                    <tree>
                        <field name="folio"/>
                    </tree>
                </field>
                <field name="layaway_credit_ids" groups="point_of_sale.group_pos_manager"
                       attrs="{'invisible': [('layaway_credit_ids', '=', [])]}">
                    <tree>
                        <field name="layaway_id"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                    </tree>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
