<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_layaway.LayawayScreenButton" owl="1">
        <span class="control-button o_pos_layaway_screen_button">
            <i class="fa fa-bookmark-o" role="img" aria-hidden="true"/>
            Apartados
        </span>
    </t>

    <t t-name="pos_layaway.LayawayScreen" owl="1">
        <div class="screen o_pos_layaway_screen">
            <header class="layaway-header">
                <button type="button" class="layaway-back" t-on-click="close"
                        t-att-disabled="state.transferBusy || state.checkoutBusy">Volver a venta</button>
                <h1>Apartados</h1>
            </header>
            <div t-if="state.stale" class="layaway-stale" role="status">
                La información puede estar desactualizada. No se pudo actualizar desde el servidor.
            </div>

            <p t-if="state.checkoutMessage" class="layaway-checkout-message" role="status"
               t-esc="state.checkoutMessage"/>

            <main t-if="state.pendingConfirmation" class="layaway-content">
                <p>Consulta el resultado de la última confirmación antes de realizar otra operación.</p>
                <button type="button" class="layaway-submit" t-on-click="confirmCheckout"
                        t-att-disabled="state.stale || state.checkoutBusy">Recuperar confirmación</button>
            </main>
            <main t-elif="state.draft" class="layaway-content layaway-checkout">
                <t t-if="state.draft.relocate" t-call="pos_layaway.LayawayRelocation"/>
                <t t-elif="state.draft.expiryReview" t-call="pos_layaway.LayawayExpiryReview"/>
                <t t-elif="state.draft.installment || state.draft.pickup" t-call="pos_layaway.LayawayInstallment"/>
                <t t-else="" t-call="pos_layaway.LayawayCheckout"/>
            </main>
            <main t-elif="!state.detail" class="layaway-content">
                <button t-if="state.canOpen" type="button" class="layaway-open-new"
                        t-att-disabled="state.stale || state.loading"
                        t-on-click="() => startCheckout(null)">Abrir apartado de prueba</button>
                <button t-if="state.canReviewExpired" type="button" class="layaway-open-new"
                        t-att-disabled="state.stale || state.loading"
                        t-on-click="showExpired">Revisar vencidos</button>
                <form class="layaway-filters" t-on-submit.prevent="search">
                    <label class="layaway-search">Folio, nombre o teléfono
                        <input type="search" name="query" t-model="state.filters.query"/>
                    </label>
                    <label>Campaña
                        <select name="campaign" t-model="state.filters.campaign">
                            <option value="">Todas</option>
                            <option t-foreach="state.campaigns" t-as="campaign" t-key="campaign.id"
                                    t-att-value="campaign.id" t-esc="campaign.name"/>
                        </select>
                    </label>
                    <label>Tienda
                        <select name="store" t-model="state.filters.store">
                            <option value="">Todas</option>
                            <option t-foreach="state.stores" t-as="store" t-key="store.id"
                                    t-att-value="store.id" t-esc="store.name"/>
                        </select>
                    </label>
                    <label>Desde
                        <input type="date" name="from" t-model="state.filters.from"/>
                    </label>
                    <label>Hasta
                        <input type="date" name="to" t-model="state.filters.to"/>
                    </label>
                    <label>Pago
                        <select name="payment_state" t-model="state.filters.payment_state">
                            <option value="">Todos</option>
                            <option t-foreach="Object.keys(paymentLabels)" t-as="key" t-key="key"
                                    t-att-value="key" t-esc="paymentLabels[key]"/>
                        </select>
                    </label>
                    <label>Entrega
                        <select name="pickup_state" t-model="state.filters.pickup_state">
                            <option value="">Todas</option>
                            <option t-foreach="Object.keys(pickupLabels)" t-as="key" t-key="key"
                                    t-att-value="key" t-esc="pickupLabels[key]"/>
                        </select>
                    </label>
                    <label>Vencimiento
                        <select name="expiry" t-model="state.filters.expiry">
                            <option value="">Todos</option>
                            <option value="expired">Vencidos</option>
                            <option value="current">Sin vencimiento pendiente</option>
                        </select>
                    </label>
                    <button type="submit" class="layaway-submit"
                            t-att-disabled="state.loading">Buscar</button>
                </form>
                <p t-if="!state.rows.length &amp;&amp; state.loaded &amp;&amp; !state.loading">No hay apartados para esta búsqueda.</p>
                <table t-if="state.rows.length" class="layaway-table">
                    <thead><tr>
                        <th>Folio</th><th>Cliente</th><th>Campaña</th><th>Apertura</th>
                        <th>Pago</th><th>Entrega</th><th>Restante</th>
                    </tr></thead>
                    <tbody>
                        <tr t-foreach="state.rows" t-as="row" t-key="row.id">
                            <td><button class="layaway-open" t-on-click="() => openDetail(row.id)"
                                        t-att-disabled="state.stale" t-esc="row.folio"/>
                                <span t-if="row.expired" class="layaway-expired"> · Vencido</span>
                            </td>
                            <td t-esc="row.customer"/><td t-esc="row.campaign"/><td t-esc="row.opened_on"/>
                            <td t-esc="paymentLabels[row.payment_state]"/>
                            <td t-esc="pickupLabels[row.pickup_state]"/>
                            <td t-esc="money(row.amount_due)"/>
                        </tr>
                    </tbody>
                </table>
                <button t-if="state.hasMore" type="button" t-att-disabled="state.loading || state.stale"
                        t-on-click="() => loadPage(state.rows.length)">Cargar más</button>
            </main>

            <main t-else="" class="layaway-content layaway-detail">
                <t t-set="folio" t-value="state.detail"/>
                <div class="layaway-detail-header">
                    <button type="button" t-on-click="backToSearch"
                            t-att-disabled="state.transferBusy">Volver a la búsqueda</button>
                    <a t-if="!state.stale" t-att-href="labelUrl" target="_blank" rel="noopener">Imprimir etiqueta</a>
                    <t t-if="!state.stale &amp;&amp; state.originalReceipt &amp;&amp; state.originalReceipt.id === folio.id">
                        <a t-if="state.originalReceipt.finalSale"
                           t-att-href="receiptUrl(state.originalReceipt.reference, true, true)"
                           target="_blank" rel="noopener"
                           t-on-click="() => openOriginalReceipt('finalSale')">Imprimir ticket final</a>
                        <a t-if="state.originalReceipt.receipt"
                           t-att-href="receiptUrl(state.originalReceipt.reference, true)"
                           target="_blank" rel="noopener"
                           t-on-click="() => openOriginalReceipt('receipt')">Imprimir comprobante</a>
                        <a t-if="state.originalReceipt.pickup"
                           t-att-href="receiptUrl(state.originalReceipt.reference, true, false, true)"
                           target="_blank" rel="noopener"
                           t-on-click="() => openOriginalReceipt('pickup')">Imprimir comprobante de recogida</a>
                    </t>
                </div>
                <h2 t-esc="folio.folio"/>
                <p><strong t-esc="folio.customer"/> · <span t-esc="folio.phone"/></p>
                <p><span t-esc="folio.campaign"/> · Recogida hasta <time t-esc="folio.pickup_end"/>
                    <strong t-if="folio.expired" class="layaway-expired"> · Vencido</strong>
                </p>
                <p><span t-esc="paymentLabels[folio.payment_state]"/> · <span t-esc="pickupLabels[folio.pickup_state]"/></p>
                <p t-if="folio.sale_name">Venta POS
                    <a t-if="folio.sale_url" t-att-href="folio.sale_url" target="_blank"
                       rel="noopener" t-esc="folio.sale_name"/>
                    <strong t-else="" t-esc="folio.sale_name"/>
                </p>
                <dl class="layaway-totals">
                    <div><dt>Total</dt><dd t-esc="money(folio.amount_total)"/></div>
                    <div><dt>Anticipo</dt><dd t-esc="money(folio.amount_deposit)"/></div>
                    <div><dt>Abonos</dt><dd t-esc="money(folio.amount_installments)"/></div>
                    <div><dt>Restante</dt><dd t-esc="money(folio.amount_due)"/></div>
                </dl>
                <t t-call="pos_layaway.LayawayStockTable"/>
                <section t-if="folio.expiry_review.can_review || folio.expiry_review.history.length"
                         class="layaway-expiry-review">
                    <h3>Revisión de vencimiento</h3>
                    <article t-foreach="folio.expiry_review.history" t-as="review" t-key="review.reference">
                        <p><strong t-esc="expiryResolutionLabels[review.resolution]"/>
                            · <span t-esc="review.reviewer"/> · <time t-esc="review.reviewed_at"/></p>
                        <p t-esc="review.notes"/>
                    </article>
                    <button t-if="folio.expiry_review.can_review" type="button" class="layaway-submit"
                            t-on-click="() => startExpiryReview(folio)"
                            t-att-disabled="state.stale || state.loading || state.transferBusy">
                        Registrar revisión de prueba
                    </button>
                </section>
                <details t-if="folio.receipts.length" class="layaway-receipts">
                    <summary>Comprobantes</summary>
                    <ul>
                        <li t-foreach="folio.receipts" t-as="receipt" t-key="receipt.reference + ':' + receipt.kind">
                            <span t-if="receipt.kind === 'open'">Apertura</span>
                            <span t-elif="receipt.kind === 'add_products'">Adición</span>
                            <span t-elif="receipt.kind === 'final_sale'">Ticket final de venta</span>
                            <span t-elif="receipt.kind === 'pickup'">Recogida</span>
                            <span t-else="">Abono</span>
                            · <span t-esc="receipt.reference"/>
                            <a t-if="receipt.available &amp;&amp; !state.stale"
                               t-att-href="receiptUrl(receipt.reference, false, receipt.kind === 'final_sale', receipt.kind === 'pickup')" target="_blank"
                               rel="noopener">Reimprimir</a>
                            <span t-if="!receipt.available"> · Original no disponible</span>
                        </li>
                    </ul>
                </details>
                <details t-if="folio.pickup.relocations.length" class="layaway-receipts">
                    <summary>Traslados de mercancía</summary>
                    <ul>
                        <li t-foreach="folio.pickup.relocations" t-as="move" t-key="move.reference">
                            <strong t-esc="move.transfer_name"/> · <span t-esc="move.source"/>
                            → <span t-esc="move.destination"/> · <time t-esc="move.confirmed_at"/>
                        </li>
                    </ul>
                </details>
                <t t-set="review" t-value="folio.transfer_review"/>
                <section t-if="review &amp;&amp; (review.methods &amp;&amp; review.methods.length || review.transfers &amp;&amp; review.transfers.length)"
                         class="layaway-transfers">
                    <h3>Transferencias de prueba</h3>
                    <form t-if="review.methods.length" class="layaway-transfer-form" t-on-submit.prevent="submitTransfer">
                        <label t-foreach="review.methods" t-as="method" t-key="method.id">
                            <span t-esc="method.name"/>
                            <input type="number" min="0" step="any" inputmode="decimal"
                                   t-att-name="'method-' + method.id"
                                   t-att-disabled="state.stale || state.transferBusy || state.transferRetry"/>
                        </label>
                        <button type="submit" class="layaway-submit" t-att-disabled="state.stale || state.transferBusy">
                            <t t-if="state.transferRetry">Recuperar registro</t>
                            <t t-else="">Registrar transferencia pendiente</t>
                        </button>
                    </form>
                    <article t-foreach="review.transfers" t-as="transfer" t-key="transfer.id"
                             class="layaway-transfer-record">
                        <p>
                            <strong t-esc="transfer.method"/> · <span t-esc="money(transfer.amount)"/> ·
                            <span t-if="transfer.confirmed">Confirmada</span>
                            <span t-else="">Pendiente de verificación</span>
                            <span t-if="transfer.bank_reference"> · <span t-esc="transfer.bank_reference"/></span>
                        </p>
                        <form t-if="transfer.can_approve &amp;&amp; !transfer.confirmed"
                              class="layaway-transfer-approval"
                              t-on-submit.prevent="event => authorizeTransfer(event, transfer.id)">
                            <p>Comprueba el abono en el banco receptor e identifica el registro que lo acredita.</p>
                            <div class="layaway-transfer-form">
                                <label>Referencia bancaria
                                    <input name="bank_reference" required="required" maxlength="120"/>
                                </label>
                                <label>Motivo
                                    <input name="reason" required="required" maxlength="500"/>
                                </label>
                                <label>Evidencia de recepción
                                    <textarea name="evidence" required="required" maxlength="2000" rows="2"/>
                                </label>
                                <button type="submit" class="layaway-submit"
                                        t-att-disabled="state.stale || state.transferBusy">Confirmar recepción</button>
                            </div>
                        </form>
                    </article>
                </section>
                <details t-if="folio.sale_adjustments.length" class="layaway-sale-adjustments">
                    <summary>Ajustes de la venta de prueba</summary>
                    <table class="layaway-table">
                        <thead><tr><th>Documento</th><th>Referencia</th><th>Diferencia</th></tr></thead>
                        <tbody>
                            <tr t-foreach="folio.sale_adjustments" t-as="adjustment" t-key="adjustment.reference">
                                <td t-esc="adjustment.name"/>
                                <td t-esc="adjustment.reference"/>
                                <td t-esc="money(adjustment.amount)"/>
                            </tr>
                        </tbody>
                    </table>
                </details>
                <details t-if="folio.payment_corrections.length || state.pendingCorrection"
                         class="layaway-payment-corrections">
                    <summary>Cobros y correcciones de prueba</summary>
                    <table class="layaway-table">
                        <thead><tr><th>Referencia</th><th>Sesión</th><th>Método</th><th>Importe</th></tr></thead>
                        <tbody>
                            <tr t-foreach="folio.payment_corrections" t-as="payment" t-key="payment.id">
                                <td>
                                    <span t-esc="payment.reference"/>
                                    <span t-if="payment.corrects">
                                        · <t t-if="payment.amount &lt; 0">Reversión de </t>
                                        <t t-else="">Sustituye a </t><span t-esc="payment.corrects"/>
                                    </span>
                                </td>
                                <td t-esc="payment.session"/>
                                <td t-esc="payment.method"/>
                                <td t-esc="money(payment.amount)"/>
                            </tr>
                        </tbody>
                    </table>
                    <form class="layaway-correction-form" t-on-submit.prevent="submitPaymentCorrection">
                        <t t-if="!state.pendingCorrection">
                            <label>Cobro original
                                <select name="payment_id" t-model="state.correctionPayment">
                                    <option value="">Seleccionar cobro</option>
                                    <t t-foreach="folio.payment_corrections" t-as="payment" t-key="payment.id">
                                        <option t-if="payment.remaining > 0 &amp;&amp; (payment.can_refund || payment.methods.length)"
                                                t-att-value="payment.id">
                                            <t t-esc="payment.method"/> · <t t-esc="money(payment.remaining)"/>
                                            · <t t-esc="payment.reference"/>
                                        </option>
                                    </t>
                                </select>
                            </label>
                            <t t-set="payment" t-value="correctionPayment"/>
                            <label t-if="payment">Tipo de corrección
                                <select name="kind" required="required" t-model="state.correctionKind">
                                    <option value="">Seleccionar tipo</option>
                                    <option t-if="payment.methods.length" value="reclassify_payment">Reclasificar método</option>
                                    <option t-if="payment.can_refund" value="refund_payment">Registrar devolución efectiva</option>
                                </select>
                            </label>
                            <div t-if="payment &amp;&amp; state.correctionKind" class="layaway-transfer-form">
                                <label t-if="state.correctionKind === 'refund_payment'">Importe devuelto
                                    <input name="amount" type="number" step="0.01" min="0.01"
                                           t-att-max="payment.remaining" required="required"/>
                                </label>
                                <t t-else="">
                                    <label>Método correcto
                                        <select name="method_id" required="required" t-model="state.correctionMethod">
                                            <option value="">Seleccionar método</option>
                                            <option t-foreach="payment.methods" t-as="method" t-key="method.id"
                                                    t-att-value="method.id" t-esc="method.name"/>
                                        </select>
                                    </label>
                                    <label t-if="correctionMethod &amp;&amp; correctionMethod.transfer">Referencia bancaria
                                        <input name="bank_reference" maxlength="120" required="required"/>
                                    </label>
                                </t>
                                <label>Motivo<input name="reason" maxlength="500" required="required"/></label>
                                <label>Evidencia de verificación
                                    <input name="evidence" maxlength="2000" required="required"/>
                                </label>
                            </div>
                        </t>
                        <button t-if="state.pendingCorrection || correctionPayment &amp;&amp; state.correctionKind"
                                type="submit" class="layaway-submit" t-att-disabled="state.stale || state.transferBusy">
                            <t t-if="state.pendingCorrection">Recuperar corrección</t>
                            <t t-else="">Autorizar corrección de prueba</t>
                        </button>
                    </form>
                </details>
                <p t-if="state.transferMessage" class="layaway-transfer-message" role="status"
                   t-esc="state.transferMessage"/>
                <div class="layaway-actions" aria-label="Operaciones del apartado">
                    <button type="button" t-att-disabled="state.stale || state.transferBusy || !folio.can_add_products"
                            t-on-click="() => startCheckout(folio)">Agregar productos</button>
                    <button t-if="folio.changeable_lines.length" type="button"
                            t-att-disabled="state.stale || state.transferBusy"
                            t-on-click="() => startCheckout(folio, true)">Retirar o sustituir productos</button>
                    <button type="button" t-att-disabled="state.stale || state.loading || state.transferBusy || !folio.installment_methods.length"
                            t-on-click="() => startInstallment(folio)">Registrar abono</button>
                    <button type="button" t-att-disabled="state.stale || state.loading || state.transferBusy || !folio.installment_methods.length"
                            t-on-click="() => startInstallment(folio, true)">Liquidar</button>
                    <button type="button"
                            t-att-disabled="state.stale || state.loading || state.transferBusy || !folio.pickup.available"
                            t-on-click="() => startPickup(folio)">Registrar recogida</button>
                    <button type="button"
                            t-att-disabled="state.stale || state.loading || state.transferBusy || !folio.pickup.can_settle || !folio.installment_methods.length"
                            t-on-click="() => startPickup(folio, true)">Liquidar y entregar</button>
                    <button t-if="folio.pickup.destinations.length" type="button"
                            t-att-disabled="state.stale || state.loading || state.transferBusy"
                            t-on-click="() => startRelocation(folio)">Registrar traslado</button>
                </div>
                <p t-if="!state.stale" class="layaway-status">Operaciones pendientes de habilitación.</p>
            </main>
        </div>
    </t>

    <t t-name="pos_layaway.LayawayExpiryReview" owl="1">
        <h2>Revisar apartado vencido <span t-esc="state.draft.folio.folio"/></h2>
        <form class="layaway-transfer-form" t-on-submit.prevent="confirmCheckout">
            <label>Resolución
                <select name="resolution" required="required">
                    <option value="">Seleccionar resolución</option>
                    <option value="keep_reserved" t-esc="expiryResolutionLabels.keep_reserved"/>
                    <option t-if="state.draft.folio.sale_name &amp;&amp; state.draft.folio.payment_state === 'paid'"
                            value="authorize_late_pickup" t-esc="expiryResolutionLabels.authorize_late_pickup"/>
                </select>
            </label>
            <label>Motivo y observaciones
                <textarea name="notes" maxlength="500" required="required"/>
            </label>
            <button type="submit" class="layaway-submit" t-att-disabled="state.stale || state.checkoutBusy">
                Guardar revisión
            </button>
        </form>
        <button type="button" t-on-click="cancelCheckout" t-att-disabled="state.checkoutBusy">Volver al folio</button>
    </t>

    <t t-name="pos_layaway.LayawayTenderFields" owl="1">
        <t t-foreach="methods" t-as="method" t-key="method.id">
            <label><span t-esc="method.name"/>
                <input type="number" min="0" step="any" inputmode="decimal"
                       t-att-name="'apply-' + method.id"/>
            </label>
            <label t-if="method.cash">Efectivo recibido
                <input type="number" min="0" step="any" inputmode="decimal"
                       t-att-name="'received-' + method.id"/>
            </label>
        </t>
    </t>

    <t t-name="pos_layaway.LayawayStockTable" owl="1">
        <table class="layaway-table">
            <thead><tr>
                <th>Producto</th><th>Tienda</th><th>Ubicación</th><th>Cantidad</th><th>Pendiente</th>
            </tr></thead>
            <tbody>
                <tr t-foreach="folio.lines" t-as="line" t-key="line.id">
                    <td t-esc="line.name"/><td t-esc="line.store"/><td t-esc="line.location"/>
                    <td t-esc="line.qty"/><td t-esc="line.pending"/>
                </tr>
            </tbody>
        </table>
    </t>

    <t t-name="pos_layaway.LayawayInstallment" owl="1">
        <t t-set="folio" t-value="state.detail"/>
        <button type="button" t-on-click="cancelCheckout" t-att-disabled="state.checkoutBusy">Volver al folio</button>
        <h2><t t-if="state.draft.pickup &amp;&amp; state.draft.settle">Liquidar y entregar de prueba</t>
            <t t-elif="state.draft.pickup">Registrar recogida de prueba</t>
            <t t-elif="state.draft.settle">Liquidar apartado de prueba</t>
            <t t-else="">Registrar abono de prueba</t> · <span t-esc="folio.folio"/></h2>
        <p t-esc="folio.customer"/>
        <dl class="layaway-totals">
            <div><dt>Total</dt><dd t-esc="money(folio.amount_total)"/></div>
            <div><dt>Anticipo</dt><dd t-esc="money(folio.amount_deposit)"/></div>
            <div><dt>Abonos</dt><dd t-esc="money(folio.amount_installments)"/></div>
            <div><dt>Restante</dt><dd t-esc="money(folio.amount_due)"/></div>
        </dl>
        <t t-call="pos_layaway.LayawayStockTable"/>
        <form t-on-submit.prevent="confirmCheckout">
            <fieldset t-att-disabled="state.stale || state.checkoutBusy || state.loading">
                <div t-if="state.draft.installment" class="layaway-transfer-form">
                    <t t-call="pos_layaway.LayawayTenderFields">
                        <t t-set="methods" t-value="state.draft.folio.installment_methods"/>
                    </t>
                </div>
                <t t-if="state.draft.pickup" t-call="pos_layaway.LayawayPickupFields"/>
                <button type="submit" class="layaway-submit">
                    <t t-if="state.draft.pickup &amp;&amp; state.draft.settle">Confirmar liquidación y recogida</t>
                    <t t-elif="state.draft.pickup">Confirmar recogida</t>
                    <t t-elif="state.draft.settle">Confirmar liquidación de prueba</t>
                    <t t-else="">Confirmar abono de prueba</t>
                </button>
            </fieldset>
        </form>
    </t>

    <t t-name="pos_layaway.LayawayPickupFields" owl="1">
        <t t-set="pickup" t-value="state.draft.folio.pickup"/>
        <h3>Bloque que se entrega en esta tienda</h3>
        <t t-call="pos_layaway.LayawayLocalBlock"/>
        <label>Receptor
            <select name="recipient" required="required">
                <option value="">Selecciona quién recibe</option>
                <option value="holder">Titular · <t t-esc="state.draft.folio.customer"/></option>
                <option t-foreach="pickup.authorizations" t-as="person" t-key="person.reference"
                        t-att-value="person.reference">Autorizado · <t t-esc="person.name"/></option>
            </select>
        </label>
        <label><input type="checkbox" name="identity_verified" required="required"/>
            Verifiqué la identidad de la persona que recibe
        </label>
    </t>

    <t t-name="pos_layaway.LayawayLocalBlock" owl="1">
        <ul>
            <li t-foreach="pickup.lines" t-as="line" t-key="line.id">
                <span t-esc="line.qty"/> × <span t-esc="line.name"/> · <span t-esc="line.location"/>
            </li>
        </ul>
    </t>

    <t t-name="pos_layaway.LayawayRelocation" owl="1">
        <t t-set="pickup" t-value="state.draft.folio.pickup"/>
        <button type="button" t-on-click="cancelCheckout" t-att-disabled="state.checkoutBusy">Volver al folio</button>
        <h2>Registrar traslado de prueba · <span t-esc="state.draft.folio.folio"/></h2>
        <h3>Bloque reservado en esta tienda</h3>
        <t t-call="pos_layaway.LayawayLocalBlock"/>
        <form t-on-submit.prevent="confirmCheckout">
            <fieldset t-att-disabled="state.stale || state.checkoutBusy || state.loading">
                <label>Ubicación de destino
                    <select name="destination" required="required">
                        <option value="">Selecciona la ubicación de recogida</option>
                        <option t-foreach="pickup.destinations" t-as="destination" t-key="destination.id"
                                t-att-value="destination.id" t-esc="destination.name"/>
                    </select>
                </label>
                <button type="submit" class="layaway-submit">Confirmar traslado físico</button>
            </fieldset>
        </form>
    </t>

    <t t-name="pos_layaway.LayawayCheckout" owl="1">
        <t t-set="draft" t-value="state.draft"/>
        <t t-set="blocked" t-value="state.stale || state.checkoutBusy"/>
        <button type="button" t-on-click="cancelCheckout" t-att-disabled="state.checkoutBusy">Volver a apartados</button>
        <h2 t-if="draft.change">Cambiar mercancía de prueba · <span t-esc="draft.folio.folio"/></h2>
        <h2 t-elif="draft.folio">Agregar productos a <span t-esc="draft.folio.folio"/></h2>
        <h2 t-else="">Abrir apartado de prueba</h2>
        <form t-if="!draft.quote" t-on-submit.prevent="quoteCheckout">
            <fieldset t-att-disabled="blocked">
                <div t-if="draft.change">
                    <h3>Líneas a retirar</h3>
                    <table class="layaway-table">
                        <thead><tr><th>Retirar</th><th>Producto</th><th>Tienda</th><th>Cantidad</th></tr></thead>
                        <tbody>
                            <tr t-foreach="changeableLines" t-as="line" t-key="line.id">
                                <td><input type="checkbox" name="remove_line"
                                           t-att-aria-label="'Retirar ' + line.name"
                                           t-att-checked="draft.removeIds.includes(line.id)"
                                           t-on-change="toggleRemoval(line.id)"/></td>
                                <td t-esc="line.name"/><td t-esc="line.store"/><td t-esc="line.qty"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div t-if="!draft.folio" class="layaway-filters">
                    <label>Campaña
                        <select name="opening_campaign" required="required"
                                t-on-change="updateCheckoutField('campaign')">
                            <option value="">Elige una campaña</option>
                            <option t-foreach="draft.campaigns" t-as="campaign" t-key="campaign.id"
                                    t-att-value="campaign.id" t-att-selected="draft.campaign === campaign.id"
                                    t-esc="campaign.name"/>
                        </select>
                    </label>
                    <p t-if="!draft.campaigns.length">No hay campañas abiertas en esta caja.</p>
                    <label>Buscar cliente
                        <input type="search" name="beneficiary" t-att-value="draft.partnerQuery"
                               t-on-input="updateCheckoutField('partnerQuery')"/>
                    </label>
                    <label>Teléfono de contacto
                        <input type="tel" name="telephone" maxlength="32" t-att-value="draft.phone"
                               t-on-input="updateCheckoutField('phone')"/>
                    </label>
                    <p t-if="draft.partner" t-esc="draft.partner.name"/>
                    <div class="layaway-actions" t-if="draft.partnerQuery">
                        <button type="button" t-foreach="matchingPartners" t-as="partner" t-key="partner.id"
                                t-on-click="() => selectPartner(partner)" t-esc="partner.name"/>
                    </div>
                </div>
                <label>Buscar producto
                    <input type="search" name="product" t-att-value="draft.productQuery"
                           t-on-input="updateCheckoutField('productQuery')"/>
                </label>
                <div class="layaway-actions" t-if="draft.productQuery">
                    <button type="button" t-foreach="matchingProducts" t-as="product" t-key="product.id"
                            t-on-click="() => addProduct(product)" t-esc="product.display_name"/>
                </div>
                <table t-if="draft.lines.length" class="layaway-table">
                    <thead><tr><th>Producto</th><th>Cantidad</th><th/></tr></thead>
                    <tbody>
                        <tr t-foreach="draft.lines" t-as="line" t-key="line.product_id">
                            <td t-esc="line.name"/>
                            <td><input type="number" min="0" step="any" required="required"
                                       aria-label="Cantidad" t-att-value="line.qty"
                                       t-on-input="updateCheckoutQuantity(line.product_id)"/></td>
                            <td><button type="button" t-on-click="() => removeProduct(line.product_id)">Quitar</button></td>
                        </tr>
                    </tbody>
                </table>
                <button type="submit" class="layaway-submit"
                        t-att-disabled="draft.change ? !draft.removeIds.length : !draft.lines.length || !draft.folio &amp;&amp; (!draft.campaign || !draft.partner)">
                    Cotizar
                </button>
            </fieldset>
        </form>
        <t t-else="">
            <t t-set="quote" t-value="draft.quote"/>
            <p t-if="!draft.change"><strong t-esc="quote.contact_name"/> · <span t-esc="quote.phone"/> ·
                <span t-esc="quote.campaign_name"/>
            </p>
            <p t-if="!draft.change">Aparta en <span t-esc="quote.warehouse"/> · Agrega hasta <time t-esc="quote.addition_end"/>
                · Recoge hasta <time t-esc="quote.pickup_end"/>
            </p>
            <table t-if="draft.change" class="layaway-table">
                <thead><tr><th>Producto por retirar</th><th>Cantidad</th><th>Total</th></tr></thead>
                <tbody>
                    <t t-foreach="quote.previous_lines" t-as="line" t-key="line.id">
                        <tr t-if="quote.removed_ids.includes(line.id)">
                            <td t-esc="line.product_name"/><td t-esc="line.qty"/>
                            <td t-esc="money(line.amount_total)"/>
                        </tr>
                    </t>
                </tbody>
            </table>
            <table t-if="quote.lines.length" class="layaway-table">
                <thead><tr><th>Producto nuevo</th><th>Cantidad</th><th>Precio unitario</th><th>Impuestos</th><th>Total</th></tr></thead>
                <tbody>
                    <tr t-foreach="quote.lines" t-as="line" t-key="line.product_id">
                        <td t-esc="line.product_name"/><td t-esc="line.qty"/>
                        <td t-esc="money(line.price_unit)"/><td t-esc="money(line.amount_tax)"/>
                        <td t-esc="money(line.amount_total)"/>
                    </tr>
                </tbody>
            </table>
            <dl class="layaway-totals">
                <div><dt>Total actualizado</dt><dd t-esc="money(quote.amount_total)"/></div>
                <div><dt>Pagado</dt><dd t-esc="money(quote.amount_paid)"/></div>
                <div t-if="draft.change || draft.folio &amp;&amp; draft.folio.sale_name">
                    <dt>Restante antes del cobro</dt><dd t-esc="money(quote.amount_due)"/>
                </div>
                <div t-if="!draft.change"><dt>Cobro necesario</dt><dd class="layaway-required" t-esc="money(quote.required_deposit)"/></div>
            </dl>
            <form t-on-submit.prevent="confirmCheckout">
                <fieldset t-att-disabled="blocked">
                    <label t-if="draft.change">Motivo de la autorización
                        <textarea name="reason" required="required" maxlength="500" rows="2"/>
                    </label>
                    <div class="layaway-transfer-form" t-elif="quote.required_deposit || !draft.folio">
                        <t t-call="pos_layaway.LayawayTenderFields">
                            <t t-set="methods" t-value="quote.methods"/>
                        </t>
                    </div>
                    <div class="layaway-actions">
                        <button type="button" t-on-click="() => draft.quote = null">Editar propuesta</button>
                        <button t-if="draft.change" type="submit" class="layaway-submit">Autorizar cambio de prueba</button>
                        <button t-else="" type="submit" class="layaway-submit">Confirmar reserva de prueba</button>
                    </div>
                </fieldset>
            </form>
        </t>
    </t>
</templates>
