<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layaway_receipt">
        <t t-call="web.html_container">
            <t t-set="quote" t-value="document.get('quote')"/>
            <t t-set="receipt" t-value="ticket or document['receipt']"/>
            <t t-set="opening" t-value="receipt.get('kind') == 'open'"/>
            <t t-set="installment" t-value="receipt.get('kind') == 'installment'"/>
            <t t-set="agreement" t-value="receipt if ticket or installment else quote"/>
            <div class="page container pt-3 pb-3">
                <button type="button" class="btn btn-secondary float-right d-print-none"
                        onclick="window.print()">Imprimir</button>
                <p t-if="reprint" class="layaway-reprint font-weight-bold">Reimpresión</p>
                <h2 t-if="ticket">Ticket final de venta de apartado</h2>
                <h2 t-elif="opening">Comprobante de apartado y anticipo</h2>
                <h2 t-elif="installment">Comprobante de abono</h2>
                <h2 t-else="">Constancia de adición de mercancía</h2>
                <div t-if="ticket" class="layaway-pickup-status">
                    <p t-if="ticket['pickup_state'] == 'done'">Liquidado · Recogida completa</p>
                    <p t-elif="ticket['pickup_state'] == 'partial'">Liquidado · Recogida parcial entre tiendas</p>
                    <p t-else="">Liquidado · Pendiente de recogida</p>
                </div>
                <p t-else="">Mercancía reservada · Recogida pendiente</p>
                <dl class="row">
                    <dt class="col-4">Campaña</dt>
                    <dd class="col-8" t-esc="agreement['campaign_name']"/>
                    <dt class="col-4">Folio</dt>
                    <dd class="col-8" t-esc="document['folio']"/>
                    <t t-if="ticket">
                        <dt class="col-4">Venta POS</dt>
                        <dd class="col-8" t-esc="document['sale_name']"/>
                    </t>
                    <dt class="col-4">Referencia de operación</dt>
                    <dd class="col-8" t-esc="document['reference']"/>
                    <dt class="col-4">Cliente</dt>
                    <dd class="col-8"><span t-esc="agreement['contact_name']"/> · <span t-esc="agreement['phone']"/></dd>
                    <t t-if="document.get('transfer_reference')">
                        <dt class="col-4">Registro de transferencia</dt>
                        <dd class="col-8" t-esc="document['transfer_reference']"/>
                    </t>
                    <t t-if="not ticket or ticket['payments']">
                        <dt t-if="ticket or installment" class="col-4">Tienda receptora</dt>
                        <dt t-else="" class="col-4">Tienda de reserva</dt>
                        <dd class="col-8" t-esc="agreement['warehouse']"/>
                    </t>
                    <dt class="col-4">Caja y sesión</dt>
                    <dd class="col-8"><span t-esc="receipt['register']"/> · <span t-esc="receipt['session']"/></dd>
                    <dt class="col-4">Cajero</dt>
                    <dd class="col-8" t-esc="receipt['cashier']"/>
                    <dt class="col-4">Fecha y hora</dt>
                    <dd class="col-8"><time t-esc="receipt['confirmed_at']"/> · <span t-esc="receipt['timezone']"/></dd>
                </dl>

                <t t-if="ticket" t-call="pos_layaway.layaway_sale_details"/>
                <t t-if="ticket and document.get('pickup')" t-call="pos_layaway.layaway_pickup_details">
                    <t t-set="pickup" t-value="document['pickup']"/>
                </t>
                <section t-if="not ticket and not installment" class="layaway-merchandise">
                    <h3 t-if="opening">Mercancía del apartado</h3>
                    <h3 t-else="">Mercancía agregada</h3>
                    <p>Importes en <span t-esc="receipt['currency']"/></p>
                    <table class="table table-sm">
                        <thead><tr>
                            <th scope="col">Producto</th>
                            <th scope="col" class="text-right">Cantidad</th>
                            <th scope="col" class="text-right">Precio unitario pactado</th>
                            <th scope="col" class="text-right">Importe sin impuestos</th>
                            <th scope="col" class="text-right">Impuestos</th>
                            <th scope="col" class="text-right">Importe total</th>
                        </tr></thead>
                        <tbody>
                            <tr t-foreach="quote['lines']" t-as="line">
                                <td t-esc="line['product_name']"/>
                                <td class="text-right" t-esc="'%g' % line['qty']"/>
                                <td class="text-right" t-esc="money(line['price_unit'])"/>
                                <td class="text-right" t-esc="money(line['amount_total'] - line['amount_tax'])"/>
                                <td class="text-right">
                                    <span t-esc="money(line['amount_tax'])"/>
                                    <small class="d-block" t-esc="tax_names[line['product_id']]"/>
                                </td>
                                <td class="text-right" t-esc="money(line['amount_total'])"/>
                            </tr>
                        </tbody>
                    </table>
                    <dl class="row">
                        <dt class="col-8">Impuestos de esta mercancía</dt>
                        <dd class="col-4 text-right" t-esc="money(tax_total)"/>
                        <t t-if="not opening">
                            <dt class="col-8">Total de la mercancía agregada</dt>
                            <dd class="col-4 text-right" t-esc="money(quote['amount_new'])"/>
                        </t>
                        <dt class="col-8">Total del apartado con impuestos</dt>
                        <dd class="col-4 text-right" t-esc="money(quote['amount_total'])"/>
                    </dl>
                </section>

                <section t-if="not ticket" class="layaway-payment">
                    <t t-if="installment">
                        <p>Importes en <span t-esc="receipt['currency']"/></p>
                        <dl class="row">
                            <dt class="col-8">Total vigente del apartado</dt>
                            <dd class="col-4 text-right" t-esc="money(receipt['amount_total'])"/>
                        </dl>
                    </t>
                    <t t-if="document['payments']">
                        <h3 t-if="opening">Anticipo recibido por método</h3>
                        <h3 t-else="">Abono recibido por método</h3>
                        <dl class="row">
                            <t t-foreach="document['payments']" t-as="payment">
                                <dt class="col-8" t-esc="payment['method_name']"/>
                                <dd class="col-4 text-right" t-esc="money(payment['amount'])"/>
                                <t t-if="installment and payment['amount_change']">
                                    <dt class="col-8">Efectivo entregado</dt>
                                    <dd class="col-4 text-right" t-esc="money(payment['amount_tendered'])"/>
                                    <dt class="col-8">Cambio devuelto</dt>
                                    <dd class="col-4 text-right" t-esc="money(payment['amount_change'])"/>
                                </t>
                            </t>
                            <dt class="col-8">Total recibido en esta operación</dt>
                            <dd class="col-4 text-right" t-esc="money(document['amount_applied'])"/>
                        </dl>
                    </t>
                    <p t-else="" class="font-weight-bold">Adición sin cobro. Cobertura suficiente con los pagos anteriores.</p>
                    <dl class="row">
                        <t t-if="not opening">
                            <dt class="col-8">Pagado antes de esta operación</dt>
                            <dd class="col-4 text-right" t-esc="money(document['amount_paid_before'] if installment else quote['amount_paid'])"/>
                            <dt class="col-8">Pagado acumulado</dt>
                            <dd class="col-4 text-right" t-esc="money(document['amount_paid'])"/>
                        </t>
                        <dt class="col-8">Restante por pagar</dt>
                        <dd class="col-4 text-right" t-esc="money(document['amount_due'])"/>
                    </dl>
                </section>

                <section t-if="not ticket and not installment">
                    <h3>Plazos y condiciones pactados</h3>
                    <ul>
                        <li t-if="opening">
                            Apertura del <time t-esc="quote['opening_start']"/> al <time t-esc="quote['opening_end']"/>.
                        </li>
                        <li>Adiciones hasta el <time t-esc="quote['addition_end']"/>.</li>
                        <li>Recogida ordinaria hasta el <time t-esc="quote['pickup_end']"/>.</li>
                        <li>Si se autoriza saldo por vencimiento, se puede usar hasta el <time t-esc="quote['credit_end']"/>.</li>
                        <li t-if="opening">Total inicial superior a <span t-esc="money(quote['minimum_amount'])"/>.</li>
                        <li>Cobertura mínima <span t-esc="'%g' % quote['deposit_percentage']"/> % del total vigente.</li>
                        <li t-foreach="receipt['conditions']" t-as="condition" t-esc="condition"/>
                    </ul>
                </section>
            </div>
        </t>
    </template>

    <template id="layaway_pickup_receipt">
        <t t-call="web.html_container">
            <div class="page container py-4">
                <button type="button" class="btn btn-primary d-print-none"
                        onclick="window.print()">Imprimir</button>
                <p t-if="reprint" class="layaway-reprint font-weight-bold">Reimpresión</p>
                <h2>Comprobante de recogida de apartado</h2>
                <dl class="row">
                    <dt class="col-4">Campaña</dt>
                    <dd class="col-8" t-esc="pickup['campaign_name']"/>
                    <dt class="col-4">Folio</dt>
                    <dd class="col-8" t-esc="pickup['folio']"/>
                    <dt class="col-4">Venta POS</dt>
                    <dd class="col-8" t-esc="pickup['sale_name']"/>
                    <dt class="col-4">Referencia de operación</dt>
                    <dd class="col-8" t-esc="pickup['reference']"/>
                    <dt class="col-4">Cliente</dt>
                    <dd class="col-8" t-esc="pickup['contact_name']"/>
                </dl>
                <p t-if="pickup['pickup_state'] == 'done'">Liquidado · Recogida completa</p>
                <p t-else="">Liquidado · Recogida parcial entre tiendas</p>
                <t t-call="pos_layaway.layaway_pickup_details"/>
            </div>
        </t>
    </template>

    <template id="layaway_pickup_details">
        <section class="layaway-pickup">
            <h3>Recogida</h3>
            <dl class="row">
                <dt class="col-4">Receptor</dt>
                <dd class="col-8"><span t-esc="pickup['recipient']['name']"/> · Identidad verificada
                    <t t-if="pickup['recipient']['kind'] == 'authorized'">
                        · Autorizado <span t-esc="pickup['recipient']['reference']"/>
                    </t>
                    <t t-else="">· Titular</t>
                </dd>
                <dt class="col-4">Tienda de recogida</dt>
                <dd class="col-8" t-esc="pickup['warehouse']"/>
                <dt class="col-4">Caja y sesión</dt>
                <dd class="col-8"><span t-esc="pickup['register']"/> · <span t-esc="pickup['session']"/></dd>
                <dt class="col-4">Cajero</dt>
                <dd class="col-8" t-esc="pickup['cashier']"/>
                <dt class="col-4">Fecha y hora</dt>
                <dd class="col-8"><time t-esc="pickup['confirmed_at']"/> · <span t-esc="pickup['timezone']"/></dd>
                <t t-if="pickup.get('late_authorization')">
                    <dt class="col-4">Autorización de recogida tardía</dt>
                    <dd class="col-8" t-esc="pickup['late_authorization']"/>
                </t>
            </dl>
            <h4>Mercancía entregada</h4>
            <t t-call="pos_layaway.layaway_pickup_lines">
                <t t-set="lines" t-value="pickup['delivered']"/>
            </t>
            <h4>Mercancía pendiente por tienda</h4>
            <t t-if="pickup['pending']" t-call="pos_layaway.layaway_pickup_lines">
                <t t-set="lines" t-value="pickup['pending']"/>
            </t>
            <p t-else="">Sin mercancía pendiente</p>
        </section>
    </template>

    <template id="layaway_pickup_lines">
        <table class="table table-sm">
            <thead><tr>
                <th scope="col">Tienda</th><th scope="col">Ubicación</th>
                <th scope="col">Producto</th><th scope="col">Cantidad</th>
            </tr></thead>
            <tbody>
                <tr t-foreach="lines" t-as="line">
                    <td t-esc="line['store']"/><td t-esc="line['location']"/>
                    <td t-esc="line['name']"/><td t-esc="'%g' % line['qty']"/>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="layaway_sale_details">
        <section class="layaway-merchandise">
            <h3>Mercancía por tienda de reserva</h3>
            <p>Importes en <span t-esc="ticket['currency']"/></p>
            <table class="table table-sm">
                <thead><tr>
                    <th scope="col">Tienda</th>
                    <th scope="col">Producto</th>
                    <th scope="col" class="text-right">Cantidad</th>
                    <th scope="col" class="text-right">Pendiente de recoger</th>
                    <th scope="col" class="text-right">Precio unitario pactado</th>
                    <th scope="col" class="text-right">Impuestos</th>
                    <th scope="col" class="text-right">Importe total</th>
                </tr></thead>
                <tbody>
                    <tr t-foreach="ticket['lines']" t-as="line">
                        <td t-esc="line['store']"/>
                        <td t-esc="line['name']"/>
                        <td class="text-right" t-esc="'%g' % line['quantity']"/>
                        <td class="text-right" t-esc="'%g' % line['pending']"/>
                        <td class="text-right" t-esc="money(line['price_unit'])"/>
                        <td class="text-right" t-esc="money(line['amount_tax'])"/>
                        <td class="text-right" t-esc="money(line['amount_total'])"/>
                    </tr>
                </tbody>
            </table>
            <dl class="row">
                <dt class="col-8">Subtotal sin impuestos</dt>
                <dd class="col-4 text-right" t-esc="money(ticket['amount_total'] - ticket['amount_tax'])"/>
                <dt class="col-8">Impuestos</dt>
                <dd class="col-4 text-right" t-esc="money(ticket['amount_tax'])"/>
                <dt class="col-8">Total de la venta con impuestos</dt>
                <dd class="col-4 text-right" t-esc="money(ticket['amount_total'])"/>
            </dl>
        </section>
        <section class="layaway-payment">
            <h3>Pagos anteriores aplicados</h3>
            <dl class="row">
                <dt class="col-8">Anticipo anterior</dt>
                <dd class="col-4 text-right" t-esc="money(ticket['previous_deposit'])"/>
                <dt class="col-8">Abonos anteriores</dt>
                <dd class="col-4 text-right" t-esc="money(ticket['previous_installments'])"/>
                <dt class="col-8">Total de pagos anteriores aplicados</dt>
                <dd class="col-4 text-right" t-esc="money(ticket['amount_previous'])"/>
            </dl>
            <h3>Dinero nuevo por método</h3>
            <p t-if="ticket['payments'] and ticket['receiving_session'] != ticket['session']">
                Caja y sesión receptoras
                <span t-esc="ticket['receiving_register']"/> · <span t-esc="ticket['receiving_session']"/>
            </p>
            <dl class="row">
                <t t-foreach="ticket['payments']" t-as="payment">
                    <dt class="col-8" t-esc="payment['method_name']"/>
                    <dd class="col-4 text-right" t-esc="money(payment['amount'])"/>
                    <t t-if="payment['amount_change']">
                        <dt class="col-8">Efectivo entregado</dt>
                        <dd class="col-4 text-right" t-esc="money(payment['amount_tendered'])"/>
                        <dt class="col-8">Cambio devuelto</dt>
                        <dd class="col-4 text-right" t-esc="money(payment['amount_change'])"/>
                    </t>
                </t>
                <dt class="col-8">Total de dinero nuevo</dt>
                <dd class="col-4 text-right" t-esc="money(ticket['amount_new'])"/>
                <dt class="col-8">Restante por pagar</dt>
                <dd class="col-4 text-right" t-esc="money(0)"/>
            </dl>
        </section>
    </template>
</odoo>
