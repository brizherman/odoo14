<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kept out of the Point of Sale category so they do not replace the User / Administrator choice. -->
    <record id="group_wholesale_manager" model="res.groups">
        <field name="name">Gerente de mayoreo en POS</field>
        <field name="comment">Puede autorizar una excepción de mayoreo o menudeo para una sola venta con el NIP del empleado del punto de venta. No puede cambiar mínimos ni asignaciones.</field>
    </record>
    <record id="group_wholesale_admin" model="res.groups">
        <field name="name">Administrador de mayoreo en POS</field>
        <field name="comment">Puede configurar mínimos, listas de precios y asignaciones por tipo de cliente.</field>
        <field name="implied_ids" eval="[(4, ref('group_wholesale_manager'))]"/>
    </record>

    <record id="point_of_sale.group_pos_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_wholesale_manager'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_wholesale_admin'))]"/>
    </record>

    <record id="pos_wholesale_mapping_company_rule" model="ir.rule">
        <field name="name">Asignación de lista de precios de mayoreo: multi-sucursal</field>
        <field name="model_id" ref="model_pos_wholesale_pricelist_mapping"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="pos_wholesale_override_company_rule" model="ir.rule">
        <field name="name">Excepción de mayoreo: multi-sucursal</field>
        <field name="model_id" ref="model_pos_wholesale_override"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
