<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="ManagerOverridePopup" owl="1">
        <div role="dialog" class="modal-dialog" aria-modal="true">
            <Draggable>
                <div class="popup wholesale-override-popup">
                    <header class="title drag-handle">
                        <t t-esc="props.title"/>
                    </header>
                    <main class="body">
                        <div class="wholesale-override-summary">
                            <div>
                                <strong><t t-esc="env._t('Automatic decision')"/>:</strong>
                                <span> <t t-esc="props.automaticDecision"/></span>
                            </div>
                            <div class="wholesale-override-auto-reason">
                                <t t-esc="props.reasonText"/>
                            </div>
                        </div>
                        <label class="label" for="wholesale-override-pin">
                            <t t-esc="env._t('Manager PIN')"/>
                        </label>
                        <input type="password"
                               id="wholesale-override-pin"
                               class="wholesale-override-pin"
                               t-model="state.pin"
                               t-ref="pin"
                               autocomplete="off"
                               inputmode="numeric"/>
                        <label class="label" for="wholesale-override-reason">
                            <t t-esc="env._t('Reason (required)')"/>
                        </label>
                        <textarea id="wholesale-override-reason"
                                  class="wholesale-override-reason"
                                  t-model="state.reason"
                                  t-ref="reason"
                                  rows="3"/>
                        <div class="wholesale-override-hint">
                            <t t-esc="env._t('This exception applies only to the current ticket. It does not change the customer type or permanent pricelist.')"/>
                        </div>
                    </main>
                    <footer class="footer">
                        <div class="button confirm" t-on-click="confirm" tabindex="0">
                            <t t-esc="props.confirmText"/>
                        </div>
                        <div class="button cancel" t-on-click="cancel" tabindex="0">
                            <t t-esc="props.cancelText"/>
                        </div>
                    </footer>
                </div>
            </Draggable>
        </div>
    </t>

</templates>
