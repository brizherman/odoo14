<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="WholesaleStatusPanel" owl="1">
        <div class="wholesale-status-panel"
             t-att-class="panelClass"
             role="status"
             aria-live="polite">
            <div class="wholesale-status-header">
                <span class="wholesale-status-icon" aria-hidden="true">
                    <i t-att-class="statusIconClass"/>
                </span>
                <div class="wholesale-status-title-block">
                    <div class="wholesale-status-title">
                        <t t-esc="statusTitle"/>
                    </div>
                    <div class="wholesale-status-customer" t-if="customerName">
                        <t t-esc="customerName"/>
                        <t t-if="customerTypeLabel"> — <t t-esc="customerTypeLabel"/></t>
                    </div>
                    <div class="wholesale-status-customer" t-else="">
                        <t t-esc="env._t('No customer selected')"/>
                    </div>
                </div>
            </div>

            <div class="wholesale-status-body">
                <div class="wholesale-status-row">
                    <span class="wholesale-status-label"><t t-esc="env._t('Pricing')"/></span>
                    <span class="wholesale-status-value">
                        <t t-esc="pricingLabel"/>
                        <t t-if="hasOverride"> (<t t-esc="env._t('Manager override')"/>)</t>
                    </span>
                </div>
                <div class="wholesale-status-row" t-if="pricelistName">
                    <span class="wholesale-status-label"><t t-esc="env._t('Pricelist')"/></span>
                    <span class="wholesale-status-value"><t t-esc="pricelistName"/></span>
                </div>
                <div class="wholesale-status-row">
                    <span class="wholesale-status-label"><t t-esc="env._t('Reason')"/></span>
                    <span class="wholesale-status-value"><t t-esc="reasonText"/></span>
                </div>
                <div class="wholesale-status-row" t-if="hasOverride">
                    <span class="wholesale-status-label"><t t-esc="env._t('Automatic')"/></span>
                    <span class="wholesale-status-value"><t t-esc="automaticDecisionLabel"/></span>
                </div>
                <div class="wholesale-status-error" t-if="errorText" role="alert">
                    <i class="fa fa-exclamation-triangle" aria-hidden="true"/>
                    <span><t t-esc="errorText"/></span>
                </div>
                <div class="wholesale-status-loading" t-if="isLoading">
                    <i class="fa fa-spinner fa-spin" aria-hidden="true"/>
                    <span><t t-esc="env._t('Checking purchase history…')"/></span>
                </div>
            </div>

            <div class="wholesale-status-months" t-if="showMonths">
                <div class="wholesale-month"
                     t-foreach="months" t-as="month" t-key="month_index">
                    <div class="wholesale-month-label">
                        <t t-esc="month.label"/>
                        <t t-if="month.is_current"> (<t t-esc="env._t('MTD')"/>)</t>
                    </div>
                    <div class="wholesale-month-amount">
                        <t t-esc="formatAmount(month.amount)"/>
                    </div>
                </div>
            </div>
            <div class="wholesale-status-months wholesale-status-months-empty" t-if="needsIdentification">
                <div class="wholesale-identify-hint">
                    <i class="fa fa-user" aria-hidden="true"/>
                    <span><t t-esc="env._t('Identify a customer to see monthly purchase totals.')"/></span>
                </div>
            </div>

            <div class="wholesale-status-actions" t-if="canRequestOverride">
                <button type="button"
                        class="wholesale-override-button"
                        t-on-click="onOverrideClick"
                        t-att-disabled="isLoading ? true : undefined">
                    <i class="fa fa-key" aria-hidden="true"/>
                    <span><t t-esc="env._t('Manager override')"/></span>
                </button>
            </div>
        </div>
    </t>

    <t t-name="ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension" owl="1">
        <xpath expr="//OrderWidget" position="after">
            <WholesaleStatusPanel t-if="env.pos.wholesaleControlActive()"/>
        </xpath>
    </t>

</templates>
