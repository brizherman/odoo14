<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_customer_type" model="ir.ui.view">
        <field name="name">res.partner.form.customer.type</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                <field name="customer_type" widget="customer_type_checkboxes" nolabel="1"/>
            </xpath>
            <xpath expr="//field[@name='mobile']" position="attributes">
                <attribute name="string">Movil (Whatsapp)</attribute>
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Expo Factor Fiesta" name="expo_factor_fiesta">
                    <group>
                        <group>
                            <field name="expo_invitation_date"/>
                            <field name="expo_invitation_status"/>
                        </group>
                    </group>
                    <group string="Plantilla de mensaje de WhatsApp">
                        <div class="text-muted" colspan="2">
                            Compartida para todos los contactos. Marcadores:
                            {customer_name}, {customer_mobile}, {company_whatsapp}.
                            Solo Administración / Ajustes puede editar esta plantilla.
                        </div>
                        <field name="expo_whatsapp_template" nolabel="1"
                                 colspan="2" readonly="1"
                                 groups="!base.group_system"/>
                        <field name="expo_whatsapp_template" nolabel="1"
                                 colspan="2"
                                 placeholder="Hola {customer_name}..."
                                 groups="base.group_system"/>
                    </group>
                    <div>
                        <button name="action_open_expo_whatsapp"
                                type="object"
                                string="Enviar invitación por WhatsApp"
                                class="btn-primary"
                                icon="fa-whatsapp"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
