<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_classifier_tree" model="ir.ui.view">
        <field name="name">res.partner.classifier.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Classify Customers" create="false"
                  default_order="total_sales_amount desc,name asc">
                <field name="name" optional="show"/>
                <field name="primary_company_id" optional="show"/>
                <field name="customer_type" optional="show"/>
                <field name="property_product_pricelist" optional="show"/>
                <field name="vat" optional="show"/>
                <field name="phone_display" string="Phone" optional="show"/>
                <field name="mobile" string="Movil (Whatsapp)" optional="show"/>
                <field name="total_sales_amount" optional="show"
                       groups="point_of_sale.group_pos_manager"/>
                <field name="sales_last_6_months" optional="show"/>
                <field name="sales_last_6_months_avg" optional="show"/>
                <field name="last_pos_sale_date" string="Última venta POS" optional="show"/>
                <field name="last_sale_order_date" string="Última venta SO" optional="show"/>
                <field name="expo_invitation_status" string="Invitación Expo" optional="show"/>
                <field name="phone" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_partner_classifier_search" model="ir.ui.view">
        <field name="name">res.partner.classifier.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Classify Customers">
                <field name="name"/>
                <field name="vat"/>
                <field name="phone"/>
                <field name="mobile" string="Movil (Whatsapp)"/>
                <separator/>
                <filter string="Sin clasificar" name="unclassified"
                        domain="[('customer_type', '=', False)]"/>
                <filter string="Mayorista" name="mayorista"
                        domain="[('customer_type', '=', 'mayorista')]"/>
                <filter string="Público General" name="publico_general"
                        domain="[('customer_type', '=', 'publico_general')]"/>
                <filter string="Distribuidores" name="distribuidores"
                        domain="[('customer_type', '=', 'distribuidores')]"/>
                <filter string="Mayorista dormido" name="mayorista_dormido"
                        domain="[('customer_type', '=', 'mayorista_dormido')]"/>
                <separator/>
                <filter string="Expo: sin invitar" name="expo_not_invited"
                        domain="[('expo_invitation_status', '=', False)]"/>
                <filter string="Expo: Le envié invitación" name="expo_sent"
                        domain="[('expo_invitation_status', '=', 'sent')]"/>
                <filter string="Expo: No contestó" name="expo_no_answer"
                        domain="[('expo_invitation_status', '=', 'no_answer')]"/>
                <filter string="Expo: Lo va a pensar" name="expo_thinking"
                        domain="[('expo_invitation_status', '=', 'thinking')]"/>
                <filter string="Expo: No" name="expo_no"
                        domain="[('expo_invitation_status', '=', 'no')]"/>
                <filter string="Expo: Lo Agregue al Grupo Expo" name="expo_added_to_group"
                        domain="[('expo_invitation_status', '=', 'added_to_expo_group')]"/>
                <separator/>
                <filter string="Con ventas" name="with_sales"
                        domain="[('primary_company_id', '!=', False)]"/>
                <filter string="Sin ventas" name="no_sales"
                        domain="[('primary_company_id', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Sucursal" name="group_sucursal"
                            context="{'group_by': 'primary_company_id'}"/>
                    <filter string="Fecha de invitación" name="group_expo_invitation_date"
                            context="{'group_by': 'expo_invitation_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_partner_classifier" model="ir.actions.act_window">
        <field name="name">Clasificar clientes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_partner_classifier_search"/>
        <field name="domain">['|', ('primary_company_id', 'in', allowed_company_ids), ('primary_company_id', '=', False)]</field>
        <field name="context">{'search_default_unclassified': 1, 'search_default_with_sales': 1, 'partner_classifier_view': True}</field>
        <field name="groups_id" eval="[(6, 0, [ref('point_of_sale.group_pos_user')])]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                All contacts are classified
            </p>
            <p>
                Select contacts, choose a type (its matching pricelist is required), then click Update.
            </p>
        </field>
    </record>

    <record id="action_partner_classifier_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_partner_classifier_tree"/>
        <field name="act_window_id" ref="action_partner_classifier"/>
    </record>

    <record id="action_partner_classifier_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="base.view_partner_form"/>
        <field name="act_window_id" ref="action_partner_classifier"/>
    </record>

    <menuitem id="menu_contacts_customers"
        name="Customers"
        parent="contacts.menu_contacts"
        sequence="3"/>

    <menuitem id="menu_partner_classifier"
        name="Clasificar clientes"
        parent="menu_contacts_customers"
        action="action_partner_classifier"
        groups="point_of_sale.group_pos_user"
        sequence="1"/>

    <menuitem id="menu_partner_classifier_pos"
        name="Clasificar Clientes"
        parent="point_of_sale.menu_point_of_sale"
        action="action_partner_classifier"
        groups="point_of_sale.group_pos_user"
        sequence="3"/>
</odoo>
