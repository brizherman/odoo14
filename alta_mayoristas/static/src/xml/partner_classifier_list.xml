<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PartnerClassifierList.controls">
        <div class="o_partner_classifier_controls d-flex flex-column ml-3 py-2">
            <span class="font-weight-bold">Tipo de Cliente</span>
            <div class="d-flex align-items-center flex-wrap mt-2">
                <label class="o_partner_classifier_label mr-2 mb-0">
                    <input type="checkbox" class="o_partner_classifier_type mr-1" value="mayorista"/>
                    Mayorista
                </label>
                <label class="o_partner_classifier_label mr-2 mb-0">
                    <input type="checkbox" class="o_partner_classifier_type mr-1" value="publico_general"/>
                    Público General
                </label>
                <label class="o_partner_classifier_label mr-2 mb-0">
                    <input type="checkbox" class="o_partner_classifier_type mr-1" value="distribuidores"/>
                    Distribuidores
                </label>
                <label class="o_partner_classifier_label mb-0">
                    <input type="checkbox" class="o_partner_classifier_type mr-1" value="mayorista_dormido"/>
                    Mayorista dormido
                </label>
            </div>
            <div class="d-flex align-items-center flex-wrap mt-3">
                <span class="font-weight-bold mr-2">Lista de precios:</span>
                <select class="o_input o_partner_classifier_pricelist">
                    <option value="">No cambiar</option>
                </select>
            </div>
            <div class="mt-3">
                <button type="button" class="btn btn-primary o_partner_classifier_update">
                    Actualizar
                </button>
            </div>
        </div>
    </t>
</templates>
