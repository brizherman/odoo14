<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="ClientDetailsEdit" t-inherit="point_of_sale.ClientDetailsEdit" t-inherit-mode="extension" owl="1">
        <xpath expr="//input[hasclass('client-name')]" position="after">
            <div class="client-detail customer-type-options">
                <label class="customer-type-option">
                    <input type="checkbox"
                           data-customer-type="mayorista"
                           t-att-checked="isCustomerTypeSelected('mayorista') ? true : undefined"
                           t-on-change="onCustomerTypeChange"/>
                    <span>Mayorista</span>
                </label>
                <label class="customer-type-option">
                    <input type="checkbox"
                           data-customer-type="publico_general"
                           t-att-checked="isCustomerTypeSelected('publico_general') ? true : undefined"
                           t-on-change="onCustomerTypeChange"/>
                    <span>Público General</span>
                </label>
                <label class="customer-type-option">
                    <input type="checkbox"
                           data-customer-type="distribuidores"
                           t-att-checked="isCustomerTypeSelected('distribuidores') ? true : undefined"
                           t-on-change="onCustomerTypeChange"/>
                    <span>Distribuidores</span>
                </label>
            </div>
        </xpath>
        <xpath expr="//input[hasclass('client-phone')]" position="after">
            <span class="label">Movil (Whatsapp)</span>
            <input class="detail client-mobile" name="mobile" type="tel"
                   t-on-change="captureChange"
                   t-att-value="props.partner.mobile || ''"/>
        </xpath>
        <xpath expr="//select[@name='property_product_pricelist']/t[@t-foreach='env.pos.pricelists']" position="before">
            <option value="" t-if="!props.partner.id">
                <t t-esc="env._t('Select Pricelist')"/>
            </option>
        </xpath>
        <xpath expr="//select[@name='property_product_pricelist']//option[@t-att-value='pricelist.id']" position="attributes">
            <attribute name="t-att-selected">isPricelistSelected(pricelist.id) ? true : undefined</attribute>
        </xpath>
    </t>

</templates>
