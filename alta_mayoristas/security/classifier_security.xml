<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- POS users need backend access and partner write for bulk classification. -->
    <record id="point_of_sale.group_pos_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="access_res_partner_pos_classifier" model="ir.model.access">
        <field name="name">res.partner POS classifier write</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="group_id" ref="point_of_sale.group_pos_user"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>
