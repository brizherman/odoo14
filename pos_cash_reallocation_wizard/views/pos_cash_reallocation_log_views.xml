<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_cash_reallocation_log_tree" model="ir.ui.view">
        <field name="name">pos.cash.reallocation.log.tree</field>
        <field name="model">pos.cash.reallocation.log</field>
        <field name="arch" type="xml">
            <tree string="Cash Reallocation History" create="0" delete="0">
                <field name="name" decoration-bf="1"/>
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="reallocation_mode" optional="show"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_amount"/>
                <field name="order_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'reverted'"/>
            </tree>
        </field>
    </record>

    <record id="view_pos_cash_reallocation_log_form" model="ir.ui.view">
        <field name="name">pos.cash.reallocation.log.form</field>
        <field name="model">pos.cash.reallocation.log</field>
        <field name="arch" type="xml">
            <form string="Cash Reallocation Log" create="0" delete="0">
                <header>
                    <field name="reallocation_mode" invisible="1"/>
                    <button name="action_undo"
                            string="Undo"
                            type="object"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'done')]}"
                            confirm="Restore original cash payment lines and remove wallet payments. Closed-session runs will also reverse posted journal entries. Continue?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_adjustment_moves"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-balance-scale"
                                attrs="{'invisible': [('adjustment_move_count', '=', 0)]}">
                            <field name="adjustment_move_count"
                                   widget="statinfo"
                                   string="Journal Entries"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="create_date"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="total_amount"/>
                            <field name="order_count"/>
                            <field name="reallocation_mode"/>
                        </group>
                    </group>
                    <group attrs="{'invisible': [('reallocation_mode', '!=', 'closed_session')]}">
                        <field name="session_ids" widget="many2many_tags"/>
                        <field name="adjustment_move_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Order Lines" name="lines">
                            <field name="line_ids" nolabel="1">
                                <tree string="Reallocation Lines" create="0" delete="0" edit="0">
                                    <field name="order_id"/>
                                    <field name="session_id" optional="hide"/>
                                    <field name="original_cash_amount"/>
                                    <field name="new_cash_amount"/>
                                    <field name="wallet_amount"/>
                                    <field name="skipped"/>
                                    <field name="skip_reason"/>
                                </tree>
                                <form string="Reallocation Line" create="0" delete="0" edit="0">
                                    <group>
                                        <field name="order_id"/>
                                        <field name="skipped"/>
                                        <field name="skip_reason"/>
                                    </group>
                                    <group>
                                        <field name="original_cash_amount"/>
                                        <field name="new_cash_amount"/>
                                        <field name="wallet_amount"/>
                                        <field name="cash_payment_id"/>
                                        <field name="wallet_payment_id"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_pos_cash_reallocation_log_search" model="ir.ui.view">
        <field name="name">pos.cash.reallocation.log.search</field>
        <field name="model">pos.cash.reallocation.log</field>
        <field name="arch" type="xml">
            <search string="Cash Reallocation History">
                <field name="name"/>
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter string="Open Session" name="open_session" domain="[('reallocation_mode', '=', 'open_session')]"/>
                <filter string="Closed Session" name="closed_session" domain="[('reallocation_mode', '=', 'closed_session')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Reverted" name="reverted" domain="[('state', '=', 'reverted')]"/>
                <separator/>
                <filter string="Date From" name="date_from" date="date_from"/>
                <group expand="0" string="Group By">
                    <filter string="User" name="group_user" domain="[]" context="{'group_by': 'user_id'}"/>
                    <filter string="Company" name="group_company" domain="[]" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Reallocation Mode" name="group_mode" domain="[]" context="{'group_by': 'reallocation_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_cash_reallocation_log" model="ir.actions.act_window">
        <field name="name">Cash Reallocation History</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">pos.cash.reallocation.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_pos_cash_reallocation_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No reallocation history yet
            </p>
            <p>
                Completed cash reallocation runs are recorded here for audit and undo.
            </p>
        </field>
    </record>

</odoo>
