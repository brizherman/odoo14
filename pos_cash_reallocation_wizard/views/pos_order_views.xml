<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_order_tree_inherit_wallet" model="ir.ui.view">
        <field name="name">pos.order.tree.wallet</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="has_wallet_payment" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_pos_order_filter_inherit_wallet" model="ir.ui.view">
        <field name="name">pos.order.filter.wallet</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <filter name="posted" position="after">
                <separator/>
                <filter string="Has Lealtad Payment"
                        name="has_wallet_payment"
                        domain="[('has_wallet_payment', '=', True)]"/>
            </filter>
            <filter name="order_month" position="after">
                <filter string="Has Lealtad Payment"
                        name="group_has_wallet_payment"
                        domain="[]"
                        context="{'group_by': 'has_wallet_payment'}"/>
            </filter>
        </field>
    </record>

</odoo>
